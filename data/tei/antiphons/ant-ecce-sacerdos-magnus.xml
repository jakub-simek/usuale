  <text>
    <body>
      <div type="antiphon" xml:id="ant-ecce-sacerdos-magnus.text">
        <head>Ecce sacérdos magnus</head>

        <ab type="liturgical-text" source="#w-do-commune-c4">
          <seg type="incipit">Ecce sacérdos magnus</seg>,
          <caesura type="asteriscus"/>
          <seg type="continuatio">qui in diébus suis plácuit Deo, et invéntus
          est justus.</seg>
        </ab>

        <note type="source-summary"
              target="#ant-ecce-sacerdos-magnus.text"
              cert="medium">cf. Sir 44,16–17</note>

        <div type="source-context" xml:id="ant-ecce-sacerdos-magnus.sources">
          <head>Text source</head>
          <ref type="bibliographic"
               target="../../indexes/bibliography.xml#bibl-sirach-44-16-17">Ecclesiasticus 44,16–17</ref>
          <note type="source-relation">The antiphon is a liturgical adaptation:
          gregorien.info relates the clause <quote>qui in diebus suis placuit
          Deo</quote> to Sir 44,16 and <quote>et inventus est iustus</quote> to
          Sir 44,17. The designation <quote>Ecce sacerdos magnus</quote> turns
          the biblical language into a formula for a holy bishop.</note>
        </div>

        <div type="notation" xml:id="ant-ecce-sacerdos-magnus.music">
          <notatedMusic xml:id="ant-ecce-sacerdos-magnus.gabc.gregobase-1914"
                        type="gabc"
                        source="#w-lu1961 #w-la1960"
                        corresp="#ant-ecce-sacerdos-magnus.text">
            <head>GregoBase transcription 1914</head>
            <ptr type="notation-file"
                 target="../../gabc/antiphons/ant-ecce-sacerdos-magnus.gabc"
                 mimeType="text/plain"/>
            <ptr type="bibliographic-record"
                 target="../../indexes/bibliography.xml#bibl-gregobase-1914"/>
          </notatedMusic>
        </div>
      </div>
    </body>
  </text>

